# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored. Never commit real credentials.

# Base URL of the RevoShop Flask API from Module 2 (no trailing slash).
NEXT_PUBLIC_API_BASE_URL=https://your-revoshop-api.example.com

# Server-only. GET /orders requires a JWT, so the Orders page logs in with
# this account on the server. Do NOT prefix these with NEXT_PUBLIC_.
API_AUTH_EMAIL=you@example.com
API_AUTH_PASSWORD=your-password
